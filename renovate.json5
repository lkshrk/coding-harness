{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  labels: ['dependencies'],
  automergeType: 'pr',
  lockFileMaintenance: { enabled: true, automerge: true },
  customManagers: [
    {
      customType: 'regex',
      description: 'Versions pinned with a "# renovate:" comment (features, agent layer, vendored schemas)',
      managerFilePatterns: ['/(^|/)features/.+\\.(sh|json)$/', '/(^|/)Dockerfile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\S+?[=:]\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
    {
      customType: 'regex',
      description: 'SHA-256 pins of a release asset: the comment carries the release, the line its checksum',
      managerFilePatterns: ['/(^|/)features/.+/tools\\.sh$/'],
      matchStrings: [
        '# renovate-digest: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+) digestVersion=(?<currentValue>\\S+)\\n\\S+?="(?<currentDigest>[0-9a-f]{64})"',
      ],
    },
    {
      customType: 'regex',
      description: 'biome.json schema URL follows the Biome version',
      managerFilePatterns: ['/(^|/)biome\\.json$/'],
      matchStrings: ['biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@biomejs/biome',
    },
  ],
  packageRules: [
    {
      description: 'Tooling and CI: safe to merge once CI is green',
      matchManagers: ['github-actions', 'bun', 'pep621'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin'],
      matchDepNames: ['!opencode-ai', '!@opencode/cli'],
      automerge: true,
    },
    {
      description: 'Base image digests: safe to merge once CI is green',
      matchManagers: ['dockerfile'],
      matchUpdateTypes: ['digest', 'pin'],
      automerge: true,
    },
    {
      description: 'Stack tool pins: safe to merge once CI is green; the agent layer stays manual',
      matchManagers: ['custom.regex', 'mise'],
      matchFileNames: ['features/stack-*/**', 'features/mise/**'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Python 3.15: hold until ruamel-yaml-clib and the other agent-layer tools ship 3.15 wheels; the image has no C compiler',
      matchDepNames: ['python'],
      allowedVersions: '<3.15',
    },
    {
      description: 'mise: the version and its per-architecture SHA-256 pins in features/mise/tools.sh move together',
      groupName: 'mise',
      matchFileNames: ['features/mise/tools.sh'],
      matchDepNames: ['jdx/mise'],
    },
    {
      description: 'uv: Feature pins (github-releases) and environment base images (docker) move together',
      groupName: 'uv',
      matchPackageNames: ['astral-sh/uv', 'github:astral-sh/uv', 'ghcr.io/astral-sh/uv'],
    },
    {
      description: 'Bun: Feature pin and the workspace packageManager move together',
      groupName: 'bun',
      matchPackageNames: ['bun', 'oven-sh/bun'],
    },
    {
      description: 'pnpm: agent-layer mise pin and the npm tools packageManager move together',
      groupName: 'pnpm',
      matchPackageNames: ['pnpm', 'aqua:pnpm/pnpm'],
    },
    {
      description: 'Biome: Feature pin, workspace dependency and biome.json schema move together',
      groupName: 'biome',
      matchPackageNames: ['@biomejs/biome', 'biomejs/biome', 'aqua:biomejs/biome'],
    },
    {
      description: 'TypeScript language tooling: one version across the stack Features',
      groupName: 'typescript tooling',
      matchFileNames: ['features/stack-*/npm/**'],
      matchPackageNames: ['typescript', 'typescript-language-server'],
    },
    {
      description: 'opencode: the per-architecture native packages of the agent layer move together',
      groupName: 'opencode',
      matchPackageNames: ['@opencode/cli-linux-x64-baseline', '@opencode/cli-linux-arm64'],
    },
    {
      description: 'Harness and agent-layer versions change agent behaviour: review by hand, re-run the evaluation',
      matchDepNames: ['@opencode/cli', '@opencode/cli-linux-x64-baseline', '@opencode/cli-linux-arm64', 'rtk-ai/rtk', 'aqua:rtk-ai/rtk'],
      automerge: false,
      labels: ['agent-behaviour'],
    },
  ],
}
