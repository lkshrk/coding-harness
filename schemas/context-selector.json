{
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "pages"],
  "properties": {
    "files": {
      "type": "array",
      "description": "candidate source files the worker needs, most relevant first",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "path exactly as listed in OUTLINES or FILES"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "why the issue needs it"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "description": "knowledge vault pages the worker needs, most relevant first",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "page path exactly as listed in PAGES" },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "why the issue needs it"
          }
        }
      }
    }
  }
}
