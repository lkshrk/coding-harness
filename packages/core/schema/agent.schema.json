{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightshift.local/schema/agent/v1",
  "title": "nightshift agent file frontmatter",
  "description": "YAML frontmatter of agents/<name>.md: OpenCode's own AgentConfig (vendored schema, not redefined here) plus nightshift's keys under 'nightshift', which the renderer strips. Cross-file rules are in agents.md, section 'Semantic rules'.",
  "type": "object",
  "required": ["description", "nightshift"],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300,
      "description": "what the agent does and when it is used; shown in tooling, never used for routing (routing is config.selection)"
    },
    "nightshift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "budget"],
      "properties": {
        "kind": {
          "enum": ["interactive", "worker", "single_call"],
          "description": "interactive: OpenCode TUI on the host; worker: headless OpenCode session in a sandbox; single_call: one model call, no tools"
        },
        "role": {
          "$ref": "#/$defs/id",
          "description": "key in config.profiles.<p>.roles that supplies the model"
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "default": [],
          "description": "skills installed and allowed for this agent; all others are denied"
        },
        "output": {
          "type": "string",
          "pattern": "^schemas/[a-z][a-z0-9-]*\\.json$",
          "description": "JSON Schema for the agent's result: the single_call response, or the worker's finish 'report' field"
        },
        "reasoning": {
          "enum": ["json_only", "free_then_json"],
          "default": "json_only",
          "description": "single_call only: free_then_json lets the model reason in text and end with one fenced json block"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_words", "input_tokens"],
          "properties": {
            "prompt_words": {
              "type": "integer",
              "minimum": 50,
              "maximum": 4000,
              "description": "max words in the body; checked in CI"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 200000,
              "description": "max tokens of the task message the supervisor builds"
            }
          }
        },
        "grace_turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "worker only: turns granted after the step or time cap to call finish"
        }
      }
    },
    "model": false,
    "prompt": false,
    "mode": false,
    "options": false,
    "tools": false
  },
  "allOf": [
    {
      "$ref": "vendor/opencode-config.schema.json#/$defs/AgentConfig"
    },
    {
      "if": {
        "properties": {
          "nightshift": {
            "properties": {
              "kind": {
                "const": "single_call"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "permission": false,
          "steps": false,
          "nightshift": {
            "required": ["output"],
            "properties": {
              "skills": {
                "maxItems": 0
              },
              "grace_turns": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nightshift": {
            "properties": {
              "kind": {
                "const": "worker"
              }
            }
          }
        }
      },
      "then": {
        "required": ["permission", "steps"]
      }
    },
    {
      "if": {
        "properties": {
          "nightshift": {
            "properties": {
              "kind": {
                "const": "interactive"
              }
            }
          }
        }
      },
      "then": {
        "required": ["permission"],
        "properties": {
          "nightshift": {
            "properties": {
              "output": false,
              "reasoning": false,
              "grace_turns": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    }
  },
  "unevaluatedProperties": false
}
