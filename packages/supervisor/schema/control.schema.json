{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightshift.local/schema/control/v1",
  "title": "nightshift control API",
  "description": "JSON over HTTP on the supervisor's Unix socket <paths.state>/nightshift.sock (mode 0600).",
  "type": "object",
  "properties": {
    "error": { "$ref": "#/$defs/errorResponse" },
    "health": { "$ref": "#/$defs/health" },
    "ok": { "$ref": "#/$defs/ok" },
    "pause": { "$ref": "#/$defs/pauseRequest" },
    "cover": { "$ref": "#/$defs/coverRequest" },
    "dependents": { "$ref": "#/$defs/dependentsRequest" },
    "dependentsResult": { "$ref": "#/$defs/dependentsResponse" },
    "send": { "$ref": "#/$defs/sendRequest" },
    "answer": { "$ref": "#/$defs/answerRequest" },
    "stop": { "$ref": "#/$defs/stopRequest" },
    "retry": { "$ref": "#/$defs/retryRequest" },
    "ingest": { "$ref": "#/$defs/ingestRequest" },
    "reviewMiss": { "$ref": "#/$defs/reviewMissRequest" },
    "reviewMissResult": { "$ref": "#/$defs/reviewMissResponse" },
    "profile": { "$ref": "#/$defs/profileRequest" },
    "profileResult": { "$ref": "#/$defs/profileResponse" },
    "implement": { "$ref": "#/$defs/implementRequest" },
    "implementResult": { "$ref": "#/$defs/implementResponse" },
    "run": { "$ref": "#/$defs/runResponse" },
    "attach": { "$ref": "#/$defs/attachInfo" }
  },
  "$defs": {
    "target": {
      "type": "string",
      "pattern": "^([A-Z][A-Z0-9]{1,6}-[1-9][0-9]*|[0-9A-HJKMNP-TV-Z]{26})$",
      "description": "Linear identifier (the issue's newest run) or run id (ULID)"
    },
    "issue": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,6}-[1-9][0-9]*$" },
    "errorCode": { "enum": ["bad_request", "not_found", "refused", "internal"] },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": { "code": { "$ref": "#/$defs/errorCode" }, "message": { "type": "string" } }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch", "gateway", "version"],
      "properties": {
        "dispatch": { "enum": ["running", "paused"] },
        "gateway": { "enum": ["ok", "unavailable"] },
        "version": { "type": "string" }
      }
    },
    "ok": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": { "ok": { "const": true } }
    },
    "pauseRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "issue": { "$ref": "#/$defs/issue" } }
    },
    "coverRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "covered"],
      "properties": { "issue": { "$ref": "#/$defs/issue" }, "covered": { "type": "boolean" } }
    },
    "dependentsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue"],
      "properties": { "issue": { "$ref": "#/$defs/issue" } }
    },
    "dependentsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues", "other"],
      "properties": {
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" },
          "description": "the issue first, then every open issue it blocks, transitively, in its team and project"
        },
        "other": {
          "type": "array",
          "description": "open dependents outside the issue's team or project; never covered",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue", "reason"],
            "properties": {
              "issue": { "$ref": "#/$defs/issue" },
              "reason": { "enum": ["other project", "other team"] }
            }
          }
        }
      }
    },
    "sendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "message"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "answerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "text"],
      "properties": { "issue": { "$ref": "#/$defs/issue" }, "text": { "type": "string", "minLength": 1 } }
    },
    "stopRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "reason": { "type": "string" },
        "now": { "type": "boolean", "description": "kill the worker without a handoff" }
      }
    },
    "retryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "continue": {
          "type": "boolean",
          "description": "continue from the commit of the latest attempt that has one, whatever its failure class"
        },
        "force_size": {
          "type": "boolean",
          "description": "dispatch once even though the issue is over its profile's size limits"
        }
      }
    },
    "ingestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue"],
      "properties": { "issue": { "$ref": "#/$defs/issue" } }
    },
    "reviewMissRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "file", "lines", "description"],
      "properties": {
        "pr": {
          "type": "string",
          "pattern": "^([1-9][0-9]*|https?://\\S+)$",
          "description": "PR URL or number"
        },
        "file": { "type": "string", "minLength": 1 },
        "lines": { "type": "string", "pattern": "^[1-9][0-9]*(-[1-9][0-9]*)?$" },
        "description": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "reviewMissResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "description": "the example file written" } }
    },
    "profileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": { "use": { "type": "string", "minLength": 1 } }
    },
    "profileResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "previous"],
      "properties": { "active": { "type": "string" }, "previous": { "type": "string" } }
    },
    "implementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "merge_mode"],
      "properties": {
        "project": { "type": "string", "minLength": 1, "description": "Linear project name" },
        "merge_mode": { "enum": ["manual", "auto"] },
        "profile": { "type": "string", "minLength": 1 }
      }
    },
    "implementResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "waiting", "warnings"],
      "properties": {
        "ready": { "type": "array", "items": { "type": "string" }, "description": "moved to Todo" },
        "waiting": { "type": "array", "items": { "type": "string" }, "description": "waiting for blockers" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": { "run": { "type": "string" } }
    },
    "attachInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "password", "session", "workdir", "fallback", "shell"],
      "properties": {
        "url": { "type": "string", "description": "OpenCode server on host loopback" },
        "password": {
          "type": "string",
          "description": "server password; pass to the TUI through its environment only"
        },
        "session": { "type": "string" },
        "workdir": { "type": "string" },
        "fallback": {
          "type": "array",
          "items": { "type": "string" },
          "description": "command that runs the TUI inside the sandbox"
        },
        "shell": {
          "type": "array",
          "items": { "type": "string" },
          "description": "command that opens a shell in the sandbox"
        }
      }
    }
  }
}
