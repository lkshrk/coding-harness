{
  "id": "stack-bun",
  "version": "0.3.0",
  "name": "nightshift bun stack",
  "description": "Bun, TypeScript with its native language server, Biome and oxlint, installed at build time for offline workers.",
  "options": {},
  "containerEnv": {
    "BUN_INSTALL_CACHE_DIR": "/var/cache/nightshift-deps/bun"
  },
  "dependsOn": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "none",
      "nodeGypDependencies": false
    }
  },
  "installsAfter": ["ghcr.io/devcontainers/features/common-utils"]
}
